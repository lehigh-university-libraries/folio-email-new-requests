# FOLIO connection. The FOLIO user must have the Requests: View permission.
folio:
  okapi_url: https://your-okapi.example.com
  tenant: your_tenant
  username: your_username
  password: your_password

email:
  smtp_host: smtp.example.com
  smtp_port: 587
  use_tls: true
  from_address: folio-requests@example.com

  # Placeholders available in subject_template:
  #   {service_point} — pickup service point name
  #   {count}         — number of new requests
  #   {plural}        — empty string for 1 request, "s" otherwise
  subject_template: "New FOLIO Requests – {service_point} ({count} new request{plural})"

  # Credentials are optional — omit both for unauthenticated relay.
  smtp_username: sender@example.com
  smtp_password: your_smtp_password

  # Keys must match FOLIO item.retrievalServicePointName exactly — the service
  # point for the item's effective location.
  # Check a live request record in FOLIO if unsure of the exact value.
  # Each entry lists the recipient addresses for that service point.
  service_points:
    "Service Point One":
      recipients:
        - staff1@example.com
    "Service Point Two":
      recipients:
        - staff2@example.com

  # Fallback recipients for service points not listed above.
  # If a service point has no entry here and no default_recipients, the script
  # logs an error and skips that group without sending email.
  # Remove or leave empty to treat all unmapped service points as errors.
  default_recipients:
    - fallback@example.com

# Fields to include per request in the email body, in this order.
# Omit this section entirely to include all fields.
# Uncomment and reorder to customize.
#
# request_fields:
#   - instance.title
#   - item.itemEffectiveLocationName
#   - item.callNumber
#   - item.barcode
#   - requestType
#   - requestDate
#   - requester.barcode
#   - pickupServicePoint.name
#   - patronComments

# Path to the state file that tracks the last processed requestDate (auto-created).
state_file: state.json

# Maximum number of requests to retrieve per FOLIO API call (pagination batch size).
request_limit: 1000
